{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"rules": {
		"no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
		"no-console": "warn",
		"typescript/no-explicit-any": "warn"
	},
	"ignorePatterns": ["dist/**", "node_modules/**", "coverage/**", "*.md"]
}
